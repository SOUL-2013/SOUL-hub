        "repoOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["repoId", "title", "column", "priority", "authorId", "repoVisibility", "repoOwnerId", "createdAt", "updatedAt"]
    },
