{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public developer profile visible across SOUL HUB without exposing private PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9][a-z0-9\\-]{1,30}[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "coverUrl": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "statusText": { "type": "string", "maxLength": 120 },
        "socialLinks": { "type": "array", "maxLength": 6 },
        "pinnedRepoIds": { "type": "array", "maxLength": 6 },
        "profileReadme": { "type": "string", "maxLength": 10000 },
        "isPrivateProfile": { "type": "boolean" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "isPrivateProfile", "followersCount", "followingCount", "createdAt", "updatedAt"]
    },
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private PII, account preferences, security settings, and storage quota.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "blockedUserIds": { "type": "array", "maxLength": 100 },
        "mutedUserIds": { "type": "array", "maxLength": 100 },
        "emailNotifications": { "type": "boolean" },
        "securityAlerts": { "type": "boolean" },
        "themePreference": { "type": "string", "enum": ["dark", "light"] },
        "storageUsedBytes": { "type": "number" },
        "quotaLimitBytes": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "storageUsedBytes", "quotaLimitBytes", "createdAt", "updatedAt"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique username reservation mapping username to uid.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9][a-z0-9\\-]{1,30}[a-z0-9]$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "Repository": {
      "title": "Repository",
      "description": "Source code repository metadata linked to a real server-side bare Git repository.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUsername": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9][a-z0-9\\-]{1,30}[a-z0-9]$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._\\-]{0,78}[a-z0-9]$" },
        "fullName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "defaultBranch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "topics": { "type": "array", "maxLength": 10 },
        "website": { "type": "string", "maxLength": 200 },
        "license": { "type": "string", "maxLength": 40 },
        "primaryLanguage": { "type": "string", "maxLength": 40 },
        "isArchived": { "type": "boolean" },
        "isTemplate": { "type": "boolean" },
        "starsCount": { "type": "number" },
        "forksCount": { "type": "number" },
        "watchersCount": { "type": "number" },
        "openIssuesCount": { "type": "number" },
        "sizeBytes": { "type": "number" },
        "forkedFrom": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "ownerUsername", "name", "slug", "fullName", "visibility", "defaultBranch", "isArchived", "starsCount", "forksCount", "watchersCount", "openIssuesCount", "createdAt", "updatedAt"]
    },
    "RepositoryMember": {
      "title": "RepositoryMember",
      "description": "Collaborator role assignment inside a repository.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 32 },
        "role": { "type": "string", "enum": ["owner", "maintainer", "developer", "read"] },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repoVisibility": { "type": "string", "enum": ["public", "private"] },
        "repoOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "role", "addedBy", "repoVisibility", "repoOwnerId", "createdAt"]
    },
    "Issue": {
      "title": "Issue",
      "description": "Repository issue and task tracking item.",
      "type": "object",
      "properties": {
        "repoId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "number": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "maxLength": 20000 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 32 },
        "labels": { "type": "array", "maxLength": 10 },
        "assigneeIds": { "type": "array", "maxLength": 5 },
        "milestone": { "type": "string", "maxLength": 80 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "commentsCount": { "type": "number" },
        "repoVisibility": { "type": "string", "enum": ["public", "private"] },
        "repoOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["repoId", "number", "title", "status", "authorId", "authorUsername", "commentsCount", "repoVisibility", "repoOwnerId", "createdAt", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on an issue, pull request, or discussion.",
      "type": "object",
      "properties": {
        "parentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repoId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 32 },
        "body": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "repoVisibility": { "type": "string", "enum": ["public", "private"] },
        "repoOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["parentId", "repoId", "authorId", "authorUsername", "body", "repoVisibility", "repoOwnerId", "createdAt", "updatedAt"]
    },
    "PullRequest": {
      "title": "PullRequest",
      "description": "Pull request comparing source and target Git branches.",
      "type": "object",
      "properties": {
        "repoId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "number": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "maxLength": 20000 },
        "sourceBranch": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetBranch": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "type": "string", "enum": ["open", "draft", "merged", "closed"] },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 32 },
        "reviewerIds": { "type": "array", "maxLength": 5 },
        "approvalsCount": { "type": "number" },
        "mergeMethod": { "type": "string", "enum": ["merge", "squash", "rebase", "none"] },
        "mergedCommitSha": { "type": "string", "maxLength": 64 },
        "repoVisibility": { "type": "string", "enum": ["public", "private"] },
        "repoOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["repoId", "number", "title", "sourceBranch", "targetBranch", "status", "authorId", "authorUsername", "approvalsCount", "repoVisibility", "repoOwnerId", "createdAt", "updatedAt"]
    },
    "PullRequestReview": {
      "title": "PullRequestReview",
      "description": "Code review decision or inline review note.",
      "type": "object",
      "properties": {
        "prId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repoId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewerUsername": { "type": "string", "minLength": 3, "maxLength": 32 },
        "state": { "type": "string", "enum": ["approved", "changes_requested", "commented"] },
        "body": { "type": "string", "maxLength": 5000 },
        "filePath": { "type": "string", "maxLength": 300 },
        "lineNumber": { "type": "number" },
        "resolved": { "type": "boolean" },
        "repoVisibility": { "type": "string", "enum": ["public", "private"] },
        "repoOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
