# GEMINI_API_KEY: Optional for AI features. Not required for core SOUL HUB functionality.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected at runtime).
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000 in AI Studio).
PORT=3000

# SOULHUB_DATA_DIR: Optional directory for bare Git repos, storage objects, and static deployments.
SOULHUB_DATA_DIR="./data"

# SOULHUB_TOKEN_PEPPER: Optional server-side pepper for Personal Access Token hashing (defaults to an ephemeral runtime secret if unset).
SOULHUB_TOKEN_PEPPER=""
